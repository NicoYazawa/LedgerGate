@startuml LedgerGate-Deployment
title LedgerGate — Local deployment (compose / kind)

skinparam shadowing false
skinparam componentStyle rectangle

node "docker compose / kind" {
  node "gateway" as GW
  node "control + React" as CTL
  node "ledger" as LED
  node "billing" as BIL
  node "payment" as PAY
  node "reconcile" as REC
  database "PostgreSQL 18" as PG
  database "Redis 7.4" as RD
  queue "NATS JetStream" as NATS
  node "Prometheus" as PROM
  node "Grafana" as GRAF
  node "Jaeger" as JAEGER
}

GW --> PG
GW --> RD
GW --> NATS
CTL --> PG
CTL --> NATS
LED --> PG
LED --> NATS
BIL --> PG
BIL --> NATS
PAY --> PG
PAY --> NATS
REC --> PG
REC --> NATS

GW --> JAEGER
CTL --> JAEGER
LED --> JAEGER
BIL --> JAEGER
PAY --> JAEGER
REC --> JAEGER
PROM --> GRAF
@enduml
